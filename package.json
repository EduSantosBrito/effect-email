{
  "name": "effect-email-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "@effect/language-service": "^0.41.0",
      "@effect/tsgo": "0.5.2",
      "@effect/vitest": "4.0.0-beta.64",
      "@types/bun": "latest",
      "@typescript/native-preview": "latest",
      "bun-types": "1.3.13",
      "effect": "^4.0.0-beta.64",
      "effect-rules": "^0.2.1",
      "knip": "^5.69.1",
      "oxfmt": "^0.48.0",
      "oxlint": "^1.63.0",
      "typescript": "latest",
      "vitest": "^4.1.5"
    }
  },
  "scripts": {
    "build": "bun --filter effect-email build",
    "check": "bun run build && bun --filter effect-email check && bun --filter effect-email-resend-example check",
    "format": "bun --bun oxfmt -c .oxlintrc.json",
    "format:check": "bun --bun oxfmt --check -c .oxlintrc.json",
    "lint": "bun --filter effect-email lint",
    "test": "bun --filter effect-email test"
  },
  "devDependencies": {
    "effect-rules": "catalog:",
    "oxfmt": "catalog:"
  }
}
