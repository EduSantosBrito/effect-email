{
  "name": "effect-email",
  "version": "0.4.0",
  "description": "Effect-first email SDK with provider-neutral core APIs and Resend support.",
  "keywords": [
    "effect",
    "email",
    "resend",
    "typescript"
  ],
  "homepage": "https://github.com/EduSantosBrito/effect-email#readme",
  "bugs": {
    "url": "https://github.com/EduSantosBrito/effect-email/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EduSantosBrito/effect-email",
    "directory": "packages/effect-email"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resend": {
      "types": "./dist/resend.d.ts",
      "import": "./dist/resend.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts ./src/resend.ts ./src/test.ts --outdir ./dist --target bun --format esm --packages external && tsgo --emitDeclarationOnly",
    "check": "bun --bun tsgo --noEmit && bun run lint",
    "format": "bun --bun oxfmt --write package.json tsconfig.json src",
    "format:check": "bun --bun oxfmt --check package.json tsconfig.json src",
    "knip": "bunx knip",
    "lint": "bun --bun oxlint -c ../../.oxlintrc.json src",
    "package:smoke": "bun run build && npm pack --dry-run",
    "prepack": "bun run build",
    "test": "bun --bun vitest run src",
    "prepare": "bun --bun effect-tsgo patch"
  },
  "dependencies": {
    "effect": "^4.0.0-beta.64"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bun-types": "catalog:",
    "effect-rules": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  }
}
