{
  "name": "effect-email-monorepo",
  "private": true,
  "description": "Monorepo for effect-email.",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "@changesets/cli": "2.31.0",
      "@cloudflare/vitest-pool-workers": "0.22.0",
      "@effect/language-service": "0.41.1",
      "@effect/tsgo": "0.5.2",
      "@effect/vitest": "4.0.0-rc.110",
      "@types/bun": "1.3.13",
      "@typescript/native-preview": "7.0.0-dev.20260517.1",
      "bun-types": "1.3.13",
      "effect": "4.0.0-rc.110",
      "effect-rules": "0.3.3",
      "knip": "5.88.1",
      "oxfmt": "0.48.0",
      "oxlint": "1.63.0",
      "pkg-pr-new": "0.0.88",
      "tstyche": "7.1.0",
      "typescript": "6.0.3",
      "vitest": "4.1.5",
      "wrangler": "4.124.0"
    }
  },
  "scripts": {
    "build": "bun --filter effect-email build",
    "check": "bun run build && bun --filter effect-email check && bun --filter effect-email-resend-example check",
    "cloudflare:dry-run": "bun --filter effect-email cloudflare:dry-run",
    "cloudflare:test": "bun --filter effect-email cloudflare:test",
    "format": "bun --bun oxfmt -c oxlint.config.ts",
    "format:check": "bun --bun oxfmt --check -c oxlint.config.ts",
    "lint": "bun --filter effect-email lint",
    "package:smoke": "bun run --cwd packages/effect-email package:smoke",
    "changeset": "bun --bun changeset",
    "changeset:status": "bun --bun changeset status",
    "changeset:version": "bun --bun changeset version",
    "test": "bun --filter effect-email test",
    "test:cloudflare": "bun --filter effect-email test:cloudflare"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "effect-rules": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "pkg-pr-new": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
