{
  "name": "effect-email",
  "version": "0.7.0",
  "description": "Effect-first email SDK with provider-neutral core APIs and Resend/SMTP support.",
  "keywords": [
    "effect",
    "email",
    "resend",
    "typescript"
  ],
  "homepage": "https://github.com/EduSantosBrito/effect-email#readme",
  "bugs": {
    "url": "https://github.com/EduSantosBrito/effect-email/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduSantosBrito/effect-email.git",
    "directory": "packages/effect-email"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resend": {
      "types": "./dist/resend.d.ts",
      "import": "./dist/resend.js"
    },
    "./smtp": {
      "types": "./dist/smtp.d.ts",
      "import": "./dist/smtp.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts ./src/resend.ts ./src/smtp.ts ./src/test.ts --outdir ./dist --target bun --format esm --packages external && tsgo --emitDeclarationOnly",
    "check": "bun --bun tsgo --project tsconfig.check.json && bun run lint && bun run type-test",
    "cloudflare:dry-run": "bun run build && bun ./test/cloudflare/run-wrangler.mjs",
    "cloudflare:test": "vitest run --config ./test/cloudflare/vitest.config.ts",
    "format": "bun --bun oxfmt --write package.json tsconfig.json src",
    "format:check": "bun --bun oxfmt --check package.json tsconfig.json src",
    "knip": "bunx knip",
    "lint": "bun --bun oxlint -c ../../oxlint.config.ts src",
    "package:smoke": "bun ./test/package-smoke/run.mjs",
    "prepack": "bun run build",
    "test": "bun --bun vitest run src",
    "test:cloudflare": "bun run cloudflare:dry-run && bun run cloudflare:test",
    "type-test": "bun --bun tstyche --root . --tsconfig ./tsconfig.tstyche.json",
    "prepare": "bun --bun effect-tsgo patch"
  },
  "dependencies": {
    "nodemailer": "9.0.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/nodemailer": "8.0.1",
    "@typescript/native-preview": "catalog:",
    "bun-types": "catalog:",
    "effect": "catalog:",
    "effect-rules": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tstyche": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.110"
  }
}
